# Copy this file to .env and fill in your own values. Never commit .env.
# REQUIRED = the backend refuses to start without it.

# --- Database ---
# REQUIRED. PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/comunisolve
# Only for smoke_test.py. Must point at a throwaway database whose name contains "test".
TEST_DATABASE_URL=postgresql://postgres:your-password@localhost:5432/comunisolve_modtest

# --- Security ---
# REQUIRED. Signs the login tokens (JWT). Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string
# REQUIRED. Secret added to every password before hashing. Never change it once users exist.
PASSWORD_PEPPER=change-me-to-another-long-random-string
# "true" in production (HTTPS only cookies). Leave "false" for http://localhost.
COOKIE_SECURE=false
# "false" in production to hide the /docs page. Default: true.
SHOW_API_DOCS=true

# --- Email (Brevo) ---
# REQUIRED. API key for sending verification codes and password reset links.
BREVO_API_KEY=your-brevo-api-key
# REQUIRED. The "from" address of those emails.
SENDER_EMAIL=you@example.com
# REQUIRED. Address of the frontend: used in email links and as the allowed CORS origin.
FRONTEND_URL=http://localhost:5173

# --- Images (Cloudinary) ---
# Optional. Without all three, image upload answers "not available right now".
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# --- AI (Gemini) ---
# Optional. Without it the AI is off and matching uses keyword similarity (TF-IDF) only.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Comma-separated models to try in order. Default: the list in Services/gemini.py.
GEMINI_MODELS=
# Read by Services/gemini.py but not used anywhere at the moment (GEMINI_MODELS decides).
GEMINI_MODEL=
# Optional. Seconds to wait for one Gemini answer. Default: 25.
GEMINI_TIMEOUT=25
# Optional. Seconds for one whole AI task, including retries. Default: 45.
AI_DEADLINE=45
# Optional. Seconds a matching answer is cached. Default: 900.
GEMINI_CACHE_TTL=900
# Optional. "true" lets GET /problems/{id}/similar also call Gemini. Default: false.
GEMINI_AUTO_ON_DETAIL=false
