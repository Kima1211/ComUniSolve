new file mode 100644
index 0000000..343cab8
--- /dev/null
+++ b/routers/matching.py
@@ -0,0 +1,82 @@
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy.orm import Session
+from typing import Optional
+
+from Models.database import get_db
+from Models import problem, solution
+from Schemas.matching import MatchRequest, MatchResponse, MatchedProblem
+from Services.matching import find_similar
+
+router = APIRouter()
+
+
+def _build_matches(query_title: str, query_description: Optional[str], db: Session, exclude_id: Optional[int] = None):
+    query = db.query(problem.Problem)
+    if exclude_id is not None:
+        query = query.filter(problem.Problem.id != exclude_id)
+    rows = query.all()
+
+    candidates = [
+        {"id": p.id, "title": p.title, "description": p.description, "category": p.category}
+        for p in rows
+    ]
+
+    ranked = find_similar(query_title, query_description, candidates)
+    if not ranked:
+        return []
+
+    by_id = {p.id: p for p in rows}
+    matched_ids = [pid for pid, _ in ranked]
+
+    # One query for every accepted solution across all matches, rather than one
+    # per match. The accepted answer is the reusable part - that is the whole
+    # point of matching an old problem to a new one.
+    accepted = (
+        db.query(solution.Solution)
+        .filter(
+            solution.Solution.problem_id.in_(matched_ids),
+            solution.Solution.status == "accepted",
+        )
+        .all()
+    )
+    accepted_by_problem = {s.problem_id: s for s in accepted}
+
+    results = []
+    for pid, score in ranked:
+        p = by_id[pid]
+        sol = accepted_by_problem.get(pid)
+        results.append(
+            MatchedProblem(
+                id=p.id,
+                title=p.title,
+                description=p.description,
+                category=p.category,
+                status=p.status,
+                score=round(score, 4),
+                accepted_solution=sol.solution_text if sol else None,
+            )
+        )
+    return results
+
+
+@router.post("/problems/match", response_model=MatchResponse)
+def match_before_posting(body: MatchRequest, db: Session = Depends(get_db)):
+    """Similar problems for text the user is still typing.
+
+    Called from the Post a Problem form so someone can see an existing answer
+    before creating a duplicate. Deliberately unauthenticated and read-only -
+    it creates nothing.
+    """
+    return MatchResponse(matches=_build_matches(body.title, body.description, db))
+
+
+@router.get("/problems/{problem_id}/similar", response_model=MatchResponse)
+def similar_to_problem(problem_id: int, db: Session = Depends(get_db)):
+    """Similar problems for one that already exists, for its detail page."""
+    fnd = db.query(problem.Problem).filter(problem.Problem.id == problem_id).first()
+    if not fnd:
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Problem not found")
+
+    return MatchResponse(
+        matches=_build_matches(fnd.title, fnd.description, db, exclude_id=problem_id)
+    )
